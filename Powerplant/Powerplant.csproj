    <ItemGroup>
      <Compile Update="Windows\ResizeImageWindow.axaml.cs">
        <DependentUpon>ResizeImageWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Controls\ToolsSettings\DrawEllipseToolSettings.axaml.cs">
        <DependentUpon>DrawEllipseToolSettings.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Resources\fonts\" />
    </ItemGroup>

    <ItemGroup>
      <BundleResource Include="Icon.icns">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </BundleResource>
    </ItemGroup>
</Project>
