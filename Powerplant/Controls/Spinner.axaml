<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Powerplant.Controls.Spinner">
    <UserControl.Styles>
        <Style Selector="Button.spinner-button">
            <Setter Property="Background" Value="#CCCCCC"></Setter>
            <Setter Property="Padding" Value="0"></Setter>
            <Setter Property="Margin" Value="0"></Setter>
            <Setter Property="CornerRadius" Value="0"></Setter>
            <Setter Property="Width" Value="12"></Setter>
            <Setter Property="Height" Value="12"></Setter>
        </Style>
        <Style Selector="Button.spinner-button:pointerover">
            <Setter Property="Background" Value="#DDDDDD"></Setter>
        </Style>
    </UserControl.Styles>
    <StackPanel Orientation="Vertical">
        <Button Classes="spinner-button" Click="SpinUpButtonClicked">
            <Svg Path="/Resources/icons/plus.svg"
                 Width="10"
                 Height="10" />
        </Button>
        <Button Classes="spinner-button" Click="SpinDownButtonClicked">
            <Svg Path="/Resources/icons/minus.svg"
                 Width="10"
                 Height="10" /> 
        </Button>
    </StackPanel>
</UserControl>
