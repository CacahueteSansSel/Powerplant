<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="300" Height="500"
        x:Class="Powerplant.Windows.ColorSelectWindow"
        CanMaximize="False"
        Title="Select a color">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="10">
            <DockPanel>
                <ColorSpectrum x:Name="ColorWheel" DockPanel.Dock="Right" ColorChanged="ColorSpectrum_OnColorChanged" Width="200"
                               Height="150" Shape="Ring">
                </ColorSpectrum>
                <Panel>
                    <Border x:Name="ColorCell" Background="Black" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Width="50" Height="50" BorderThickness="2"
                            BorderBrush="Black">

                    </Border>
                </Panel>
            </DockPanel>
            <TabControl Padding="0">
                <TabItem Header="RGBA" FontSize="15">
                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" x:Name="ColorTextR"
                                     TextChanged="ColorTextR_OnTextChanged" Margin="10 0 0 0" Width="50"
                                     MinWidth="0">
                            </TextBox>
                            <ColorSlider x:Name="ColorSpinR" ValueChanged="ColorSpinR_OnValueChanged"
                                         ColorComponent="Component1" Width="130" DockPanel.Dock="Right">
                            </ColorSlider>
                            <TextBlock VerticalAlignment="Center">Red</TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" x:Name="ColorTextG"
                                     TextChanged="ColorTextG_OnTextChanged" Margin="10 0 0 0" Width="50"
                                     MinWidth="0">
                            </TextBox>
                            <ColorSlider x:Name="ColorSpinG" ValueChanged="ColorSpinG_OnValueChanged"
                                         ColorComponent="Component2" Width="130" DockPanel.Dock="Right">
                            </ColorSlider>
                            <TextBlock VerticalAlignment="Center">Green</TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" x:Name="ColorTextB"
                                     TextChanged="ColorTextB_OnTextChanged" Margin="10 0 0 0" Width="50"
                                     MinWidth="0">
                            </TextBox>
                            <ColorSlider x:Name="ColorSpinB" ValueChanged="ColorSpinB_OnValueChanged"
                                         ColorComponent="Component3" Width="130" DockPanel.Dock="Right">
                            </ColorSlider>
                            <TextBlock VerticalAlignment="Center">Blue</TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" x:Name="ColorTextA"
                                     TextChanged="ColorTextA_OnTextChanged" Margin="10 0 0 0" Width="50"
                                     MinWidth="0">
                            </TextBox>
                            <ColorSlider x:Name="ColorSpinA" ValueChanged="ColorSpinA_OnValueChanged"
                                         ColorComponent="Alpha" Width="130" DockPanel.Dock="Right">
                            </ColorSlider>
                            <TextBlock VerticalAlignment="Center">Alpha</TextBlock>
                        </DockPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="HSV" FontSize="15">
                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" x:Name="ColorTextH" IsHitTestVisible="False"
                                     TextChanged="ColorTextH_OnTextChanged" Margin="10 0 0 0" Width="50"
                                     MinWidth="0">
                            </TextBox>
                            <ColorSlider x:Name="ColorSpinH" ValueChanged="ColorSpinH_OnValueChanged"
                                         ColorComponent="Component1" ColorModel="Hsva" Width="130"
                                         DockPanel.Dock="Right">
                            </ColorSlider>
                            <TextBlock VerticalAlignment="Center">Hue</TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" x:Name="ColorTextS" IsHitTestVisible="False"
                                     TextChanged="ColorTextS_OnTextChanged" Margin="10 0 0 0" Width="50"
                                     MinWidth="0">
                            </TextBox>
                            <ColorSlider x:Name="ColorSpinS" ValueChanged="ColorSpinS_OnValueChanged"
                                         ColorComponent="Component2" ColorModel="Hsva" Width="130"
                                         DockPanel.Dock="Right">
                            </ColorSlider>
                            <TextBlock VerticalAlignment="Center">Saturat.</TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" x:Name="ColorTextV" IsHitTestVisible="False"
                                     TextChanged="ColorTextV_OnTextChanged" Margin="10 0 0 0" Width="50"
                                     MinWidth="0">
                            </TextBox>
                            <ColorSlider x:Name="ColorSpinV" ValueChanged="ColorSpinV_OnValueChanged"
                                         ColorComponent="Component3" ColorModel="Hsva" Width="130"
                                         DockPanel.Dock="Right">
                            </ColorSlider>
                            <TextBlock VerticalAlignment="Center">Value</TextBlock>
                        </DockPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="HEX" FontSize="15">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Right" x:Name="HexText"
                                 TextChanged="HexText_OnTextChanged"
                                 Margin="10 0 0 0" Width="130" MinWidth="0">
                            #FF000000
                        </TextBox>
                        <TextBlock VerticalAlignment="Center">Hexadecimal</TextBlock>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom">
            <Button DockPanel.Dock="Right" Classes="primary" Click="SelectButtonClicked">Select</Button>
            <Button DockPanel.Dock="Right" Margin="0 0 5 0" Click="Button_OnClick">Cancel</Button>
            <Panel></Panel>
        </DockPanel>
        <Panel></Panel>
    </DockPanel>
</Window>