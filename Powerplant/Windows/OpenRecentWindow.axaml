<Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Width="400" Height="500" Title="Open Recent"
             x:Class="Powerplant.Windows.OpenRecentWindow">
    <DockPanel Margin="10">
        <TextBlock Classes="title" DockPanel.Dock="Top" Margin="0 0 0 10">Open Recent</TextBlock>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 10 0 0">
            <Button Click="CancelButtonClicked">Cancel</Button>
            <Button Click="OpenButtonClicked" IsDefault="True" Classes="primary">Open</Button>
        </StackPanel>
        <ListBox x:Name="RecentFilesListBox" SelectionMode="Single" SelectionChanged="RecentFilesListBox_OnSelectionChanged"></ListBox>
    </DockPanel>
</Window>
